# Server
PORT=5830
JWT_SECRET=your-secret-key-change-in-production
FRONTEND_URL=http://localhost:5829
TARGET_SERVICE=http://localhost:8042

# SQLite + SQLCipher (file-based, encrypted)
DB_PATH=./data/orthanc.db
DB_KEY=your-secure-encryption-key

# Owner (not in database; login requires email OTP)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=your-secure-password
OWNER_NAME=Owner

# Email (Gmail for verification and owner OTP)
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=your_app_password
EMAIL_FROM_NAME=EMEDX

# Optional
REQUIRE_VERIFY_EMAIL=false
WORD_FILES_UPLOAD_PATH=./uploads
