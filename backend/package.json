{
  "name": "orthanc-backend",
  "version": "1.0.0",
  "description": "Backend proxy server for Orthanc frontend",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:frontend": "cd ../frontend && npm run build",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/orthanc-backend.exe --icon ./assets/emedx.ico"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "pkg": {
    "scripts": [
      "server.js",
      "config/**/*.js",
      "routes/**/*.js",
      "middleware/**/*.js",
      "models/**/*.js",
      "utils/**/*.js"
    ],
    "assets": [
      "assets/**/*",
      ".env",
      "frontend-dist/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.9",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1"
  }
}
